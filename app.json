{
  "expo": {
    "name": "DiaryArt",
    "slug": "diary-art",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "diaryart",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF5F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diaryart.app",
      "infoPlist": {
        "NSCameraUsageDescription": "日記に写真を追加するためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "日記に写真を追加するためにフォトライブラリを使用します。",
        "NSPhotoLibraryAddUsageDescription": "生成した作品をフォトライブラリに保存します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.diaryart.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "日記に写真を追加するためにカメラを使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "日記に写真を追加するためにフォトライブラリを使用します。"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8A598",
          "defaultChannel": "default"
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
